// GitHub Codespaces / Dev Containers: runs the Python version of 3D Reader.
// Code -> Codespaces -> Create codespace installs everything, starts the server
// and opens the forwarded port 8000 (https://<codespace>-8000.app.github.dev).
// Server log: /tmp/reader3d.log. Restart it with
//   python -m reader3d serve --host 0.0.0.0 --port 8000
{
  "name": "3D Reader",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    // Node builds the browser engine assets (npm run vendor) and runs the JS tests.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "memory": "4gb" },

  // libgl1 first: the OpenCascade wheel (cadquery-ocp) links its viewer
  // libraries against libGL.so.1, which this image lacks, and without it
  // `import OCP` (so the server) fails. A failing extra apt source must not
  // stop it, hence `|| true`. Then the Python engine (OpenCascade, trimesh)
  // and the browser engine files, so the page offers both engines.
  "postCreateCommand": "(sudo apt-get update || true) && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libgl1 && pip install -r requirements-dev.txt && npm ci && npm run vendor",

  // Each time the codespace is opened: unless the server already answers (a
  // process-name check would match this very shell command), start it in the
  // background and wait until it answers. If it stops or does not answer within
  // 90 s, print the end of its log and fail, so the error shows in the terminal
  // instead of a port that never opens.
  "postAttachCommand": "log=/tmp/reader3d.log; up() { curl -fs -o /dev/null http://127.0.0.1:8000/config.json; }; up && exit 0; nohup python -m reader3d serve --host 0.0.0.0 --port 8000 > \"$log\" 2>&1 & pid=$!; for i in $(seq 90); do sleep 1; if up; then echo \"3D Reader is running on port 8000 (log: $log)\"; exit 0; fi; kill -0 $pid 2>/dev/null || break; done; echo \"3D Reader did not start. End of $log:\" >&2; tail -n 20 \"$log\" >&2; exit 1",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "3D Reader", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
